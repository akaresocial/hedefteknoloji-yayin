# Eski /destek/ PHP klasöründeki indirme dosyası artık kökte (config/preserve-extra.txt)
RewriteRule ^destek/(PureVPN-7\.2\.5\.apk)$ /$1 [R=301,L]

# Listede olmayan eski ürün, kategori ve arşiv adresleri
RewriteRule ^urun/ /markalar/ [R=301,L]
RewriteRule ^urun-kategori/ /markalar/ [R=301,L]
RewriteRule ^(category|tag|author)/ / [R=301,L]
RewriteRule ^page/[0-9]+/?$ / [R=301,L]
RewriteRule ^[0-9]{4}/[0-9]{2}/ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Yayın kimliği (ops/release.mjs yazar; sunucudaki canlı test ve release --wait okur): hiç önbelleğe alınmaz
  <Files "version.txt">
    Header set Cache-Control "no-store"
  </Files>
  # HTML her ziyarette doğrulanır; görseller 30 gün önbellekte
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(svg|png|webp|jpg|jpeg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Yazı tiplerinin adında içerik özeti var (public/fonts, _next/static/media): bir yıl, değişmez
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
