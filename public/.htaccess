# ──────────────────────────────────────────────────────────────
# Hedef Teknoloji — otomatik üretildi (scripts/build-htaccess.mjs)
# Ortam: CANLI · Elle düzenlemeyin; config/legacy-redirects.json'u güncelleyin.
# ──────────────────────────────────────────────────────────────

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
DirectorySlash On
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType application/vnd.android.package-archive .apk .APK
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Yalnız bu sitenin adları. cPanel'de belge kökü public_html içinde olan başka bir alan adı bu dosyayı da
# devralır; ona hiçbir kural (https/www yönlendirmesi, 403'ler) uygulanmaz. Sondaki nokta (hedefteknolojibilisim.com.)
# da bu sitedir: sunucu onu aynı siteye eşler, %{HTTP_HOST} ise ham başlıktır — yoksa tek başlıkla 403'ler atlanırdı.
RewriteCond %{HTTP_HOST} !^((www|mail)\.)?hedefteknolojibilisim\.com\.?(:[0-9]+)?$ [NC]
RewriteRule ^ - [L]

# SSL doğrulaması (AutoSSL / Let's Encrypt): /.well-known/ hiçbir kurala takılmaz, http'de bile yönlendirilmez
RewriteRule ^\.well-known/ - [L]

# Nokta ile başlayan tüm yollar (/.git, /.env, macOS ._ kopyaları …) ve iç PHP dosyaları (_smtp_client.php vb.) dışarıya kapalı.
# Açık uç noktalar: api/form.php (formlar), api/yayin.php (anlık yayın tetiği; yalnız POST) — başlıkları api/.htaccess'te
RewriteRule (^|/)\. - [F,L]
RewriteRule ^api/_ - [F,L]

# Eski sitedeki davranış korunur: OpenAI GPTBot tarayıcısı engelli (önceki .htaccess)
RewriteCond %{HTTP_USER_AGENT} GPTBot [NC]
RewriteRule ^ - [F,L]

# Kanonik adres: https + www olmadan (tek atlamada).
# Hata sayfasının iç isteği (ErrorDocument → /404.html) yönlendirilmez; yoksa http'de 404 yerine 301 döner
# (ör. /.well-known/ altında olmayan dosya — SSL doğrulaması 404 bekler).
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteCond %{HTTP_HOST} ^www\.hedefteknolojibilisim\.com\.?(:[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://hedefteknolojibilisim.com/$1 [R=301,L,NE]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://hedefteknolojibilisim.com/$1 [R=301,L,NE]

# /sayfa/index.html → /sayfa/ (yinelenen içerik olmasın)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# WordPress eski sorgu adresleri (?p=, ?page_id=, ?product=) → ana sayfa
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|product|product_cat|post_type|s)= [NC]
RewriteRule ^$ /? [R=301,L]

# Next.js hata sayfalarının dizin kopyaları doğrudan açılmasın
RewriteRule ^(404|_not-found)(/.*)?$ - [R=404,L]

# Tema demosundan kalan şablon sayfaları: kalıcı olarak kaldırıldı
RewriteRule ^(banner|footer|header|megamenu|title_section|model|pxl-template)/ - [G,L]

# WordPress artıkları
RewriteRule ^(wp-admin|wp-login\.php)(/.*)?$ / [R=301,L]
RewriteRule ^(xmlrpc\.php|wp-json|wp-includes|wp-content|comments/feed)(/.*)?$ - [G,L]
RewriteRule ^(.+)/feed/?$ /$1/ [R=301,L]
RewriteRule ^feed/?$ / [R=301,L]

# Eski WordPress adresleri → yeni hedefler (247 kural)
RewriteRule ^category/news/?$ / [R=301,L]
RewriteRule ^category/adblue-iptali/?$ https://hedefecu.com/hizmetlerimiz/adblue_iptali/ [R=301,L]
